[Unit]
Description=earnfm (호스트)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
IPAccounting=yes
EnvironmentFile=/etc/default/earnfm-host
# 장치 ID(Go 클라이언트)는 EARNFM_DATA_DIR/deviceid에 남는다. 호스트는 자기 /etc/machine-id를 쓴다.
Environment=EARNFM_DATA_DIR=/var/lib/earnfm/host
ExecStartPre=+/bin/mkdir -p /var/lib/earnfm/host
ExecStart=/usr/local/bin/earnfm
Restart=always
RestartSec=30
# 정지는 곧장 죽인다(장치 ID 파일 외에 지킬 상태가 없다).
KillSignal=SIGKILL
TimeoutStopSec=5
# 위 SIGKILL로 멈춘 걸 실패로 치지 않는다(안 그러면 정지할 때마다 failed로 남는다).
SuccessExitStatus=SIGKILL
# 트래픽 한 건마다 requestId 줄을 남겨 시간당 1만~1.7만 줄(전체의 99%)이다. 저널 200MB가 2~3일에 차서
# 다른 로그까지 밀려났다. 이 줄만 버린다. 수명주기(접속·limited·서버 다운) 줄은 requestId가 없어 남는다.
LogFilterPatterns=~requestId

[Install]
WantedBy=multi-user.target
