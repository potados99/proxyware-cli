[Unit]
Description=earnfm worker %i
Requires=worker-net@%i.service
After=worker-net@%i.service worker-dhcp@%i.service
StartLimitIntervalSec=0

[Service]
Slice=proxyware.slice
IPAccounting=yes
NetworkNamespacePath=/run/netns/w%i
EnvironmentFile=/etc/default/earnfm-worker%i
Environment=HOME=/tmp
# 장치 ID(Go 클라이언트, 2026-09-10 이미지~): EARNFM_DATA_DIR/deviceid에 machine-id로 만들어 두고 계속 쓴다.
# 같은 호스트의 워커가 /etc/machine-id를 공유하면 전부 한 기기로 잡히므로, 워커마다 machine-id를 따로 만들어 덮는다.
# 클라이언트는 deviceid를 /etc/earnfm에도 복사해 두고 그쪽을 먼저 읽는다(2026-10-03 nest w01이 w07의 ID를 물려받음).
# 그래서 /etc/earnfm도 워커 디렉터리로 덮는다.
Environment=EARNFM_DATA_DIR=/var/lib/earnfm/w%i
ExecStartPre=+/bin/sh -c 'd=/var/lib/earnfm/w%i; mkdir -p $$d /etc/earnfm; [ -s $$d/machine-id ] || head -c16 /dev/urandom | od -An -tx1 | tr -dc 0-9a-f > $$d/machine-id'
# 덮어쓰기는 BindReadOnlyPaths로 못 한다: systemd는 마운트 네임스페이스를 첫 명령(+ 포함) 전에 만들어서,
# 처음 기동할 때는 위 파일이 아직 없어 유닛이 통째로 실패한다(226/NAMESPACE). 그래서 아래 ExecStart에서 직접 붙인다.
ExecStartPre=/bin/sh -c "for i in $(seq 30); do ip -4 addr show eth0 | grep -q \"inet \" && exit 0; sleep 1; done; exit 1"
# 장치 이름은 "EarnFM Client <hostname>"이다. 호스트 이름 그대로면 대시보드에 같은 이름이 8개 뜨므로,
# 워커만의 UTS 네임스페이스를 만들어 <prefix>-worker<NN>(pawns device-id와 같은 규칙)으로 바꾼다.
# 호스트의 이름·machine-id는 바뀌지 않는다(unshare가 실패하면 뒤 명령은 실행되지 않는다).
ExecStart=/usr/bin/unshare --uts --mount --propagation private /bin/sh -c 'mount --bind -o ro /var/lib/earnfm/w%i/machine-id /etc/machine-id && mount --bind /var/lib/earnfm/w%i /etc/earnfm && hostname "$$(hostname | tr A-Z a-z | sed s/pi$$//)-worker%i" && exec /usr/local/bin/earnfm'
Restart=always
RestartSec=30
# 정지는 곧장 죽인다(장치 ID 파일 외에 지킬 상태가 없다).
KillSignal=SIGKILL
TimeoutStopSec=5
# 위 SIGKILL로 멈춘 걸 실패로 치지 않는다(안 그러면 정지할 때마다 failed로 남는다).
SuccessExitStatus=SIGKILL
# 트래픽 한 건마다 requestId 줄을 남겨 시간당 1만~1.7만 줄(전체의 99%)이다. 저널 200MB가 2~3일에 차서
# 다른 로그까지 밀려났다. 이 줄만 버린다. 수명주기(접속·limited·서버 다운) 줄은 requestId가 없어 남는다.
LogFilterPatterns=~requestId
PrivatePIDs=yes
PrivateTmp=yes
NoNewPrivileges=yes
BindReadOnlyPaths=/etc/proxyware/resolv.conf:/etc/resolv.conf

[Install]
WantedBy=multi-user.target
