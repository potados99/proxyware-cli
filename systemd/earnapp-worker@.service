[Unit]
Description=earnapp worker %i
Requires=worker-net@%i.service
After=worker-net@%i.service worker-dhcp@%i.service
StartLimitIntervalSec=0

[Service]
Slice=proxyware.slice
IPAccounting=yes
NetworkNamespacePath=/run/netns/w%i
Environment=HOME=/tmp
# earnapp 번들 Node(18.5.0)의 CA 스토어가 낡아 client.earnapp.com의 SSL.com 체인을
# SELF_SIGNED_CERT_IN_CHAIN으로 거부한다(시스템 openssl/curl은 정상 검증). 이게 없으면
# 기기 등록이 전부 실패하고 대시보드에서 "device not found"가 뜬다. 공식 install.sh로도
# 동일하게 실패하는 벤더 버그이므로 시스템 CA를 주입해 우회한다.
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
ExecStartPre=/bin/sh -c "for i in $(seq 30); do ip -4 addr show eth0 | grep -q \"inet \" && exit 0; sleep 1; done; exit 1"
# 'run'은 --help에 안 나오는 숨은 포그라운드 커맨드다(공식 서비스 파일에서 확인).
# 공개된 'start'는 스스로 데몬화해서 systemd Type=simple과 맞지 않는다.
ExecStart=/usr/local/bin/earnapp run
Restart=always
RestartSec=30
ProtectHostname=yes
PrivatePIDs=yes
PrivateTmp=yes
NoNewPrivileges=yes
# 기기 식별자(uuid)는 /etc/earnapp/uuid 파일 하나다. netns는 파일시스템을 공유하므로
# 이 바인드마운트가 없으면 모든 워커가 uuid 하나를 공유해 "기기 1대가 IP N개를 오가는"
# 꼴이 된다(= 어뷰징으로 보임). 워커별로 갈라야 각자 독립 기기가 된다.
BindPaths=/etc/proxyware/earnapp/w%i:/etc/earnapp
BindReadOnlyPaths=/etc/proxyware/resolv.conf:/etc/resolv.conf

[Install]
WantedBy=multi-user.target
